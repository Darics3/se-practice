@startuml
title SIS #04 - Before Refactoring

component "main.tsx" as Main
component "App.tsx" as App
component "sampleData.ts" as Data
component "booking.ts" as Booking
component "bookingLogic.ts" as BookingLogic
component "types.ts" as Types

Main --> App : renders

App --> Data : imports rooms,\nbookings
App --> Booking : calls canBook()
App --> BookingLogic : time helpers,\ncheckAvailability()
App --> Types : CheckResult

Data --> Types : Room, Booking
BookingLogic --> Types : Room, Booking,\nCheckResult

note right of App
UI also performs:
- selected room lookup
- room booking filtering
- availability coordination
- timeline rendering
end note

@enduml